---
interface Props {
    title: string;
}

const {title} = Astro.props;
---

<div class="my-4">
    <details class="group border border-slate-200 rounded-lg bg-white shadow-sm overflow-hidden transition-all duration-150">
        <summary class="flex justify-between items-center px-4 py-2 cursor-pointer hover:bg-slate-50 list-none">
            <span class="font-bold text-slate-800 tracking-tight flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"/>
                {title}
            </span>
            <div class="text-emerald-500 transition-transform duration-150 group-open:rotate-180">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                </svg>
            </div>
        </summary>
        <div class="p-2 border-t border-slate-100 bg-slate-50/30">
            <div class="prose prose-sm max-w-none text-slate-600 leading-relaxed">
                <slot/>
            </div>
        </div>
    </details>
</div>