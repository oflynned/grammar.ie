---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<div class="my-6">
    <details
            class="group border rounded-xl border-background-border dark:border-background-border-dark bg-background-colour dark:bg-background-colour-dark overflow-hidden transition-all duration-200"
    >
        <summary
                class="flex justify-between items-center px-5 py-3 cursor-pointer hover:bg-brand-primary/5 list-none select-none transition-colors"
        >
            <span class="font-bold text-text-colour-main dark:text-text-colour-main-dark tracking-tight flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-brand-primary shadow-[0_0_8px_var(--color-brand-primary)]" />
                {title}
            </span>

            <div class="text-brand-primary transition-transform duration-300 group-open:rotate-180">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                </svg>
            </div>
        </summary>

        <div class="px-5 py-4 border-t border-background-border dark:border-background-border-dark bg-brand-glow/5">
            <div class="prose prose-sm dark:prose-invert max-w-none text-text-colour-muted dark:text-text-colour-muted-dark leading-relaxed">
                <slot/>
            </div>
        </div>
    </details>
</div>

<style>
    summary::-webkit-details-marker {
        display: none;
    }
</style>