---
interface Props {
    title: string;
    before: string;
    after: string;
    rule: string;
}

const {title, before, after, rule} = Astro.props;
---

<div class="bg-slate-900 rounded-lg px-6 py-3 my-8 text-white relative overflow-hidden shadow-xl">
    <div class="relative z-10">
        <h4 class="text-emerald-400 font-bold text-xs uppercase tracking-widest mb-4">{title}</h4>

        <div class="flex items-center gap-6 mb-4">
            <div class="flex flex-col">
                <span class="text-xs text-slate-500 font-bold uppercase mb-1">Base</span>
                <span class="text-md sm:text-xl font-mono text-slate-300">{before}</span>
            </div>

            <div class="text-emerald-500 pt-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"/>
                    <path d="m12 5 7 7-7 7"/>
                </svg>
            </div>

            <div class="flex flex-col">
                <span class="text-xs text-emerald-500 font-bold uppercase mb-1 font-sans">Mutated</span>
                <span class="text-md sm:text-xl font-mono font-bold text-white tracking-wide">{after}</span>
            </div>
        </div>

        <p class="text-sm text-slate-400 border-t border-slate-800 pt-4 italic">
            <span class="text-emerald-500 font-bold not-italic">Rule:</span> {rule}
        </p>
    </div>

    <div class="absolute top-0 right-0 -mt-4 -mr-4 w-24 h-24 bg-emerald-600/10 rounded-full blur-2xl"/>
</div>