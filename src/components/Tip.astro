---
interface Props {
  title?: string;
}

const { title = 'Tip' } = Astro.props;
---

<aside
  role="note"
  aria-label={title}
  class="my-5 grid gap-1.5 rounded-lg border border-sky-200 bg-sky-50 px-4 py-3.5 text-[0.9375rem] leading-relaxed text-slate-700 dark:border-sky-500/25 dark:bg-sky-500/10 dark:text-slate-300"
>
  <div class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest text-sky-600 dark:text-sky-400">
    <svg class="size-4 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5"/>
      <path d="M8 5v4M8 11v.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    {title}
  </div>
  <div class="[&_p]:m-0 [&_p+p]:mt-2">
    <slot />
  </div>
</aside>
