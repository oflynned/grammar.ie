<div class="grammar-search relative" data-search-root>
    <button
            type="button"
            class="inline-flex h-8 w-8 items-center justify-center rounded-md text-slate-500 transition-colors duration-200 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary dark:text-slate-400 dark:hover:text-white md:hidden"
            aria-label="Search grammar content"
            aria-haspopup="dialog"
            aria-expanded="false"
            title="Search"
            data-search-open>
        <svg class="theme-mode-icon"
             xmlns="http://www.w3.org/2000/svg"
             viewBox="0 0 24 24"
             aria-hidden="true">
            <path d="m21 21-4.34-4.34"></path>
            <circle cx="11" cy="11" r="8"></circle>
        </svg>
    </button>

    <div class="relative hidden w-64 md:block" data-search-context="desktop">
        <label class="sr-only" for="site-search-desktop">Search grammar content</label>
        <div class="relative">
            <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                 xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
                <path d="m21 21-4.34-4.34"></path>
                <circle cx="11" cy="11" r="8"></circle>
            </svg>
            <input
                    id="site-search-desktop"
                    type="text"
                    role="searchbox"
                    autocomplete="off"
                    enterkeyhint="search"
                    spellcheck="false"
                    placeholder="Search"
                    class="h-10 w-full rounded-lg border border-background-border bg-white pl-9 pr-3 text-sm text-slate-800 outline-none transition-colors placeholder:text-slate-400 focus:border-brand-primary focus:ring-2 focus:ring-emerald-500/20 dark:border-background-border-dark dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500"
                    aria-controls="site-search-results-desktop"
                    aria-expanded="false"
                    data-search-input
            />
        </div>

        <div
                id="site-search-results-desktop"
                class="search-results-panel absolute right-0 top-full z-30 mt-2 hidden overflow-hidden rounded-lg border border-background-border bg-white shadow-xl shadow-slate-950/10 dark:border-background-border-dark dark:bg-slate-900 dark:shadow-black/30"
                data-search-panel>
            <p class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400" data-search-status></p>
            <ol class="max-h-96 overflow-y-auto p-2" data-search-results></ol>
        </div>
    </div>

    <div
            class="fixed inset-0 z-50 hidden md:hidden"
            role="dialog"
            aria-modal="true"
            aria-labelledby="site-search-mobile-title"
            data-search-modal>
        <div
                class="absolute inset-0 bg-slate-950/40 backdrop-blur-sm dark:bg-black/60"
                data-search-backdrop>
        </div>

        <section class="relative mx-auto mt-3 flex max-h-[calc(100dvh-1.5rem)] w-[calc(100vw-1.5rem)] max-w-lg flex-col overflow-hidden rounded-lg border border-background-border bg-white shadow-2xl shadow-slate-950/20 dark:border-background-border-dark dark:bg-slate-900 dark:shadow-black/40"
                 data-search-context="mobile">
            <header class="flex items-center justify-between gap-3 border-b border-background-border px-4 py-3 dark:border-background-border-dark">
                <h2 id="site-search-mobile-title" class="text-base font-semibold text-slate-900 dark:text-slate-100">
                    Search
                </h2>
                <button
                        type="button"
                        class="theme-mode-button"
                        aria-label="Close search"
                        data-search-close>
                    <svg class="theme-mode-icon"
                         xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M18 6 6 18"></path>
                        <path d="m6 6 12 12"></path>
                    </svg>
                </button>
            </header>

            <div class="border-b border-background-border p-4 dark:border-background-border-dark">
                <label class="sr-only" for="site-search-mobile">Search grammar content</label>
                <div class="relative">
                    <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                         xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="m21 21-4.34-4.34"></path>
                        <circle cx="11" cy="11" r="8"></circle>
                    </svg>
                    <input
                            id="site-search-mobile"
                            type="text"
                            role="searchbox"
                            autocomplete="off"
                            enterkeyhint="search"
                            spellcheck="false"
                            placeholder="Search grammar"
                            class="h-11 w-full rounded-lg border border-background-border bg-white pl-9 pr-3 text-base text-slate-800 outline-none transition-colors placeholder:text-slate-400 focus:border-brand-primary focus:ring-2 focus:ring-emerald-500/20 dark:border-background-border-dark dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500"
                            aria-controls="site-search-results-mobile"
                            aria-expanded="false"
                            data-search-input
                    />
                </div>
            </div>

            <div id="site-search-results-mobile"
                 class="hidden min-h-0 flex-1 overflow-y-auto"
                 data-search-panel>
                <p class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400" data-search-status></p>
                <ol class="p-2" data-search-results></ol>
            </div>
        </section>
    </div>
</div>

<script>
    type PagefindResultData = {
        url: string;
        excerpt: string;
        meta: {
            title?: string;
        };
        sub_results?: PagefindSubResult[];
    };

    type PagefindWeightedLocation = {
        balanced_score?: number;
    };

    type PagefindSubResult = {
        title: string;
        url: string;
        excerpt: string;
        anchor?: {
            id: string;
        };
        weighted_locations?: PagefindWeightedLocation[];
    };

    type PagefindResult = {
        data: () => Promise<PagefindResultData>;
    };

    type PagefindModule = {
        search: (query: string) => Promise<{ results: PagefindResult[] }>;
    };

    type SearchContext = {
        root: HTMLElement;
        input: HTMLInputElement;
        panel: HTMLElement;
        status: HTMLElement;
        resultsList: HTMLOListElement;
        mode: 'desktop' | 'mobile';
    };

    const root = document.querySelector<HTMLElement>('[data-search-root]');
    const openButton = root?.querySelector<HTMLButtonElement>('[data-search-open]');
    const modal = root?.querySelector<HTMLElement>('[data-search-modal]');
    const backdrop = root?.querySelector<HTMLElement>('[data-search-backdrop]');
    const closeButtons = Array.from(root?.querySelectorAll<HTMLButtonElement>('[data-search-close]') ?? []);
    const contexts = Array.from(root?.querySelectorAll<HTMLElement>('[data-search-context]') ?? [])
        .map<SearchContext | undefined>((contextRoot) => {
            const input = contextRoot.querySelector<HTMLInputElement>('[data-search-input]');
            const panel = contextRoot.querySelector<HTMLElement>('[data-search-panel]');
            const status = contextRoot.querySelector<HTMLElement>('[data-search-status]');
            const resultsList = contextRoot.querySelector<HTMLOListElement>('[data-search-results]');
            const mode = contextRoot.dataset.searchContext === 'mobile' ? 'mobile' : 'desktop';

            if (!input || !panel || !status || !resultsList) return undefined;

            return {
                root: contextRoot,
                input,
                panel,
                status,
                resultsList,
                mode,
            };
        })
        .filter((context): context is SearchContext => Boolean(context));

    if (root && openButton && modal && contexts.length > 0) {
        let pagefindPromise: Promise<PagefindModule> | undefined;
        let searchTimeout: number | undefined;
        let searchRequest = 0;
        let selectedIndex = -1;
        let activeContext: SearchContext = contexts[0];

        const mobileContext = contexts.find((context) => context.mode === 'mobile');

        document.body.append(modal);

        const setPanelOpen = (context: SearchContext, isOpen: boolean) => {
            context.panel.classList.toggle('hidden', !isOpen);
            context.input.setAttribute('aria-expanded', String(isOpen));
        };

        const setStatus = (context: SearchContext, message: string) => {
            context.status.textContent = message;
            context.status.classList.toggle('hidden', message.length === 0);
        };

        const searchLinks = (context = activeContext) => Array.from(context.resultsList.querySelectorAll<HTMLAnchorElement>('a'));

        const setSelectedIndex = (index: number) => {
            const links = searchLinks();
            selectedIndex = links.length ? (index + links.length) % links.length : -1;

            links.forEach((link, linkIndex) => {
                link.dataset.selected = String(linkIndex === selectedIndex);
            });

            links[selectedIndex]?.focus();
        };

        const setBodyScrollLocked = (isLocked: boolean) => {
            document.documentElement.classList.toggle('overflow-hidden', isLocked);
            document.body.classList.toggle('overflow-hidden', isLocked);
        };

        const openModal = () => {
            if (!mobileContext) return;

            activeContext = mobileContext;
            modal.classList.remove('hidden');
            openButton.setAttribute('aria-expanded', 'true');
            setBodyScrollLocked(true);
            window.setTimeout(() => mobileContext.input.focus(), 0);

            if (mobileContext.input.value.trim().length > 0) {
                runSearch(mobileContext);
            }
        };

        const closeModal = () => {
            modal.classList.add('hidden');
            openButton.setAttribute('aria-expanded', 'false');
            setBodyScrollLocked(false);
            setPanelOpen(mobileContext ?? activeContext, false);
            openButton.focus();
        };

        const loadPagefind = () => {
            const pagefindPath = '/pagefind/pagefind.js';
            pagefindPromise ??= import(/* @vite-ignore */ pagefindPath) as Promise<PagefindModule>;
            return pagefindPromise;
        };

        const resultTitle = (data: PagefindResultData) => {
            const fallback = data.url.replace(/^\//, '').replace(/\/$/, '').replace(/-/g, ' ');
            return (data.meta.title || fallback || 'Untitled').replace(/\s+\|\s+Grammar\.ie$/, '');
        };

        const resultScore = (result: PagefindSubResult) => {
            return Math.max(...(result.weighted_locations ?? []).map((location) => location.balanced_score ?? 0), 0);
        };

        const bestSubResult = (data: PagefindResultData) => {
            const anchoredResults = (data.sub_results ?? []).filter((result) => result.anchor);
            return anchoredResults.toSorted((a, b) => resultScore(b) - resultScore(a)).at(0);
        };

        const resultUrl = (data: PagefindResultData) => {
            const url = bestSubResult(data)?.url ?? data.url;

            try {
                const parsedUrl = new URL(url, window.location.href);
                return `${parsedUrl.pathname}${parsedUrl.search}${parsedUrl.hash}`;
            } catch {
                return url;
            }
        };

        const resultLabel = (data: PagefindResultData) => {
            const pageTitle = resultTitle(data);
            const sectionTitle = bestSubResult(data)?.title;

            if (!sectionTitle || sectionTitle === pageTitle) return pageTitle;

            return `${pageTitle} / ${sectionTitle}`;
        };

        const resultExcerpt = (data: PagefindResultData) => {
            return bestSubResult(data)?.excerpt ?? data.excerpt;
        };

        const formatSegment = (segment: string) => {
            return segment
                .replace(/-/g, ' ')
                .replace(/\b\w/g, (letter) => letter.toUpperCase());
        };

        const resultPathLabel = (data: PagefindResultData) => {
            try {
                const url = new URL(resultUrl(data), window.location.href);
                const segments = url.pathname.split('/').filter(Boolean);

                return segments.slice(0, 2).map(formatSegment).join(' / ');
            } catch {
                return '';
            }
        };

        const renderResults = async (results: PagefindResult[], requestId: number, context: SearchContext) => {
            const resultData = await Promise.all(results.slice(0, 8).map((result) => result.data()));
            if (requestId !== searchRequest || context !== activeContext) return;

            context.resultsList.replaceChildren();
            selectedIndex = -1;

            resultData.forEach((data) => {
                const item = document.createElement('li');
                const link = document.createElement('a');
                const path = document.createElement('span');
                const title = document.createElement('span');
                const excerpt = document.createElement('span');

                link.href = resultUrl(data);
                link.className = 'block rounded-md px-3 py-2 no-underline transition-colors hover:bg-emerald-50 focus:bg-emerald-50 focus:outline-none dark:hover:bg-emerald-500/10 dark:focus:bg-emerald-500/10';
                path.className = 'mb-1 block text-[0.7rem] font-semibold uppercase tracking-normal text-emerald-700 dark:text-emerald-300';
                title.className = 'block text-sm font-semibold text-slate-900 dark:text-slate-100';
                excerpt.className = 'mt-1 line-clamp-2 block text-xs leading-5 text-slate-600 dark:text-slate-400';

                path.textContent = resultPathLabel(data);
                title.textContent = resultLabel(data);
                excerpt.innerHTML = resultExcerpt(data);

                link.addEventListener('click', () => {
                    if (context.mode === 'mobile') {
                        setBodyScrollLocked(false);
                        modal.classList.add('hidden');
                        openButton.setAttribute('aria-expanded', 'false');
                    }
                });

                if (path.textContent) {
                    link.append(path);
                }
                link.append(title, excerpt);
                item.append(link);
                context.resultsList.append(item);
            });

            setStatus(context, resultData.length ? '' : 'No results found.');
            setPanelOpen(context, true);
        };

        const runSearch = async (context: SearchContext) => {
            activeContext = context;
            const query = context.input.value.trim();
            const requestId = searchRequest + 1;
            searchRequest = requestId;

            if (query.length === 0) {
                context.resultsList.replaceChildren();
                setStatus(context, '');
                setPanelOpen(context, false);
                return;
            }

            if (query.length < 2) {
                context.resultsList.replaceChildren();
                setStatus(context, 'Type at least 2 characters.');
                setPanelOpen(context, true);
                return;
            }

            setStatus(context, 'Searching...');
            setPanelOpen(context, true);

            try {
                const pagefind = await loadPagefind();
                const search = await pagefind.search(query);
                await renderResults(search.results, requestId, context);
            } catch {
                if (requestId !== searchRequest || context !== activeContext) return;

                context.resultsList.replaceChildren();
                setStatus(context, 'Search is available after the site has been built.');
                setPanelOpen(context, true);
            }
        };

        const queueSearch = (context: SearchContext) => {
            window.clearTimeout(searchTimeout);
            searchTimeout = window.setTimeout(() => runSearch(context), 180);
        };

        contexts.forEach((context) => {
            context.input.addEventListener('input', () => queueSearch(context));
            context.input.addEventListener('focus', () => {
                activeContext = context;
                if (context.input.value.trim().length > 0) {
                    setPanelOpen(context, true);
                }
            });
        });

        openButton.addEventListener('click', openModal);
        backdrop?.addEventListener('click', closeModal);
        closeButtons.forEach((button) => button.addEventListener('click', closeModal));

        const handleSearchKeydown = (event: KeyboardEvent) => {
            if (event.key === 'Escape') {
                if (!modal.classList.contains('hidden')) {
                    closeModal();
                } else {
                    setPanelOpen(activeContext, false);
                    activeContext.input.focus();
                }
                return;
            }

            if (event.key === 'ArrowDown') {
                event.preventDefault();
                setSelectedIndex(selectedIndex + 1);
                return;
            }

            if (event.key === 'ArrowUp') {
                event.preventDefault();
                setSelectedIndex(selectedIndex - 1);
                return;
            }

            if (event.key === 'Enter' && document.activeElement === activeContext.input) {
                const [firstLink] = searchLinks();
                if (firstLink) {
                    firstLink.click();
                }
            }
        };

        root.addEventListener('keydown', handleSearchKeydown);
        modal.addEventListener('keydown', handleSearchKeydown);

        document.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Node) || root.contains(target)) return;

            contexts
                .filter((context) => context.mode === 'desktop')
                .forEach((context) => setPanelOpen(context, false));
        });
    }
</script>
