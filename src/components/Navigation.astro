---
interface Props {
    category: string
}

const {category} = Astro.props
---

<nav class="z-20 sticky top-0 text-sm text-slate-400 p-8 bg-white/80 backdrop-blur-md border-b border-slate-100 font-medium">
    <section class="mx-auto flex justify-between max-w-6xl">
        <div>
            <a href="/" class="hover:text-emerald-600">Home</a>
            <span class="mx-2">/</span>
            <a href="/prepositions" class="hover:text-emerald-600">{category}</a>
        </div>
        <div>
            <button class="text-slate-400 hover:text-emerald-600">Search...</button>
        </div>
    </section>
</nav>