---
import type {CollectionEntry} from 'astro:content';
import {getCollection} from 'astro:content';
import PageContent from '../layouts/PageContent.astro';
import TableOfContents from './TableOfContents.astro';
import Tag from "./Tag.astro";
import {collections} from "../content.config";
import {directChildrenForPath, entryPath, titleForPath} from '../lib/contentTree';

interface Props {
    entry: CollectionEntry<keyof typeof collections>;
}

const {entry} = Astro.props;
const {Content, headings} = await entry.render();
const hasTableOfContents = headings && Array.isArray(headings) && headings.length > 1;
const pageTitle = entry.data.enTitle
const tags = entry.data.tags ?? [];
const entries = await getCollection('grammar');
const currentPath = entryPath(entry);
const parentPath = currentPath.split('/').slice(0, -1).join('/');
const parentTitle = parentPath ? titleForPath(entries, parentPath) : 'Home';
const parentHref = parentPath ? `/${parentPath}` : '/';
const siblingPages = directChildrenForPath(entries, parentPath).filter((child) => child.kind === 'page');
const currentIndex = siblingPages.findIndex((child) => child.slug === currentPath);
const previousPage = currentIndex > 0 ? siblingPages[currentIndex - 1] : undefined;
const nextPage = currentIndex >= 0 && currentIndex < siblingPages.length - 1 ? siblingPages[currentIndex + 1] : undefined;
---

<PageContent title={pageTitle}>
    <section class="flex mx-auto w-full max-w-6xl gap-12">
        <article class="flex-1 min-w-0 prose dark:prose-invert" data-pagefind-body>
            <header class="mb-8">
                <h1 class="text-4xl font-extrabold mb-4 tracking-tight">
                    {pageTitle}
                </h1>

                <p class="leading-relaxed text-lg">
                    {entry.data.description}
                </p>

                <div class="flex gap-2 mt-6 flex-wrap">
                    {tags.map(tag => (
                            <Tag tag={tag}/>
                    ))}
                </div>


            </header>

            <hr/>

            {hasTableOfContents ? <TableOfContents headings={headings} variant="mobile"/> : null}

            <Content/>

            <nav class="not-prose mt-16 border-t border-background-border pt-8 dark:border-background-border-dark"
                 aria-label="Article navigation"
                 data-pagefind-ignore>
                <div class="grid gap-3 sm:grid-cols-2">
                    {previousPage ? (
                            <a href={previousPage.href}
                               class="group flex min-h-28 flex-col justify-between rounded-lg border border-background-border bg-white p-5 text-left no-underline transition-colors hover:border-brand-primary dark:border-background-border-dark dark:bg-slate-900 dark:hover:border-brand-primary-dark">
                                <span class="text-xs font-semibold uppercase tracking-normal text-slate-500 dark:text-slate-400">Previous</span>
                                <span class="mt-3 text-base font-bold text-slate-900 group-hover:text-brand-primary dark:text-slate-100 dark:group-hover:text-brand-primary-dark">
                                    {previousPage.title}
                                </span>
                            </a>
                    ) : null}

                    {nextPage ? (
                            <a href={nextPage.href}
                               class="group flex min-h-28 flex-col justify-between rounded-lg border border-background-border bg-white p-5 text-left no-underline transition-colors hover:border-brand-primary dark:border-background-border-dark dark:bg-slate-900 dark:hover:border-brand-primary-dark sm:text-right">
                                <span class="text-xs font-semibold uppercase tracking-normal text-slate-500 dark:text-slate-400">Next</span>
                                <span class="mt-3 text-base font-bold text-slate-900 group-hover:text-brand-primary dark:text-slate-100 dark:group-hover:text-brand-primary-dark">
                                    {nextPage.title}
                                </span>
                            </a>
                    ) : null}
                </div>

                <a href={parentHref}
                   class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-slate-600 no-underline transition-colors hover:text-brand-primary dark:text-slate-300 dark:hover:text-brand-primary-dark">
                    <svg class="h-4 w-4"
                         xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="m15 18-6-6 6-6"></path>
                    </svg>
                    Back to {parentTitle}
                </a>
            </nav>
        </article>

        {hasTableOfContents ?
                <aside class="hidden md:block w-64 shrink-0">
                    <div class="sticky top-32">
                        <TableOfContents headings={headings} variant="desktop"/>
                    </div>
                </aside> : null}
    </section>
</PageContent>

<script>
    const headings = document.querySelectorAll('article h2, article h3');
    const LINK_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-link transition-all duration-300 absolute inset-0"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>';
    const COPIED_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-check transition-all duration-300 absolute inset-0 opacity-0 scale-50"><path d="m12 15l2 2l4-4"></path><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>';

    const scrollHeadingIntoView = (id: string, behavior: ScrollBehavior = 'auto') => {
        const heading = document.getElementById(id);
        if (!heading) return;

        const scrollMarginTop = Number.parseFloat(window.getComputedStyle(heading).scrollMarginTop) || 0;
        const top = heading.getBoundingClientRect().top + window.scrollY - scrollMarginTop;
        window.scrollTo({top: Math.max(0, top), behavior});
    };

    const scrollHashIntoView = (behavior: ScrollBehavior = 'auto') => {
        const id = decodeURIComponent(window.location.hash.replace('#', ''));
        if (!id) return;

        window.requestAnimationFrame(() => scrollHeadingIntoView(id, behavior));
    };

    headings.forEach((heading) => {
        const id = heading.getAttribute('id');
        if (!id) return;

        const anchor = document.createElement('a');
        anchor.href = `#${id}`;
        anchor.className = 'anchor-link relative h-6 w-6 shrink-0 opacity-100 md:opacity-0 group-hover:opacity-100 transition-all duration-300 text-slate-500 dark:text-slate-400 flex items-center justify-center no-underline';
        anchor.innerHTML = `${LINK_SVG}${COPIED_SVG}`;
        anchor.title = 'Copy link to this section';

        anchor.addEventListener('click', (e) => {
            e.preventDefault();

            const url = new URL(window.location.href);
            url.hash = id;
            navigator.clipboard.writeText(url.toString());

            const linkIcon = anchor.querySelector('.lucide-link');
            const checkIcon = anchor.querySelector('.lucide-check');

            linkIcon?.classList.add('opacity-0', 'scale-50');
            checkIcon?.classList.remove('opacity-0', 'scale-50');
            checkIcon?.classList.add('opacity-100', 'scale-100');

            setTimeout(() => {
                linkIcon?.classList.remove('opacity-0', 'scale-50');
                checkIcon?.classList.add('opacity-0', 'scale-50');
                checkIcon?.classList.remove('opacity-100', 'scale-100');
            }, 1000);

            window.history.pushState(null, '', `#${id}`);
        });

        heading.classList.add('group', 'flex', 'flex-wrap', 'items-center', 'gap-2');
        heading.appendChild(anchor);
    });

    window.addEventListener('load', () => scrollHashIntoView('auto'));
    window.addEventListener('hashchange', () => scrollHashIntoView('smooth'));
</script>
