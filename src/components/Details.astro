---
interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<details class="group my-5 min-w-0 max-w-full rounded-lg border border-slate-200 bg-white text-[0.9375rem] leading-relaxed text-slate-700 open:shadow-sm dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-300">
  <summary class="flex cursor-pointer select-none list-none items-center gap-2 px-4 py-3 text-xs font-semibold uppercase tracking-widest text-slate-500 transition-colors hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 [&::-webkit-details-marker]:hidden">
    <svg
      class="size-3.5 shrink-0 rotate-0 transition-transform duration-200 group-open:rotate-90"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
    >
      <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    {summary}
  </summary>
  <div class="note-content border-t border-slate-200 px-4 py-3.5 dark:border-slate-700 [&_p]:m-0 [&_p+p]:mt-2">
    <slot />
  </div>
</details>
