---
import Page from './Page.astro';
import Navigation from "../components/Navigation.astro";
import type {Breadcrumb} from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
}

const {title} = Astro.props
const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbs = segments.map<Breadcrumb>((segment, index) => {
    const url = '/' + segments.slice(0, index + 1).join('/');
    const title = segment
        .replace(/-/g, ' ')
        .replace(/\b\w/g, (l) => l.toUpperCase())

    return {title, url};
})

const formattedBreadcrumbs = breadcrumbs.length > 2 ? breadcrumbs.slice(0, -1).concat({title}) : breadcrumbs
---

<Page title={title}>
    <main class="flex flex-col min-h-screen transition-colors duration-300">
        <Navigation breadcrumbs={formattedBreadcrumbs}/>

        <section class="prose dark:prose-invert flex flex-1 mx-auto w-full max-w-6xl gap-12 px-4 py-12">
            <slot/>
        </section>

        <Footer/>
    </main>
</Page>
