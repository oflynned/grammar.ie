---
import Page from './Page.astro';
import Navigation from "../components/Navigation.astro";
import type {Breadcrumb} from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    seoTitle?: string;
    description?: string;
    canonicalUrl?: string;
    ogType?: 'website' | 'article';
    ogImage?: string;
    ogImageAlt?: string;
    keywords?: string[] | string;
    schema?: Record<string, unknown> | Array<Record<string, unknown>>;
    noindex?: boolean;
}

const {
    title,
    seoTitle,
    description,
    canonicalUrl,
    ogType,
    ogImage,
    ogImageAlt,
    keywords,
    schema,
    noindex,
} = Astro.props;
const formatSegment = (segment: string) => {
    const labelOverrides: Record<string, string> = {
        bi: 'Bí',
        conjugated: 'Conjugated Prepositions',
        dean: 'Déan',
        i: 'i',
        o: 'Ó',
        tri: 'Trí',
    };

    if (labelOverrides[segment]) return labelOverrides[segment];

    return segment
        .replace(/-/g, ' ')
        .replace(/\b\w/g, (letter) => letter.toUpperCase());
}
const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbs = segments.map<Breadcrumb>((segment, index) => {
    const url = '/' + segments.slice(0, index + 1).join('/') + '/';
    const title = formatSegment(segment)

    return {title, url};
})

const formattedBreadcrumbs = breadcrumbs.length > 1 ? breadcrumbs.slice(0, -1).concat({title}) : breadcrumbs
---

<Page
    title={title}
    seoTitle={seoTitle}
    description={description}
    canonicalUrl={canonicalUrl}
    ogType={ogType}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    keywords={keywords}
    schema={schema}
    noindex={noindex}
    breadcrumbs={formattedBreadcrumbs}
>
    <main class="flex flex-col min-h-screen transition-colors duration-300">
        <Navigation breadcrumbs={formattedBreadcrumbs}/>

        <section class="prose dark:prose-invert flex flex-1 mx-auto w-full max-w-6xl gap-12 px-4 py-12">
            <slot/>
        </section>

        <Footer/>
    </main>
</Page>
