---
import PageContent from "../layouts/PageContent.astro";
import Card from "../components/Card.astro";

type Module = {
    title: Record<'en' | 'ga', string>,
    url: string,
}

const modules: Module[] = [
    {title: {en: 'Nouns', ga: 'AN tAINMFHOCAL'}, url: '/nouns',},
    {title: {en: 'Articles', ga: 'AN CÓNASC'}, url: '/articles',},
    {title: {en: 'Adjectives', ga: 'AN AIDIACHT'}, url: '/adjectives',},
    {title: {en: 'Copula', ga: 'AN CHOPAIL'}, url: '/copula',},
    {title: {en: 'Verbs', ga: 'AN BRIATHAR'}, url: '/verbs',},
    {title: {en: 'Adverbs', ga: 'AN DOBRIATHAR'}, url: '/adverbs',},
    {title: {en: 'Prepositions', ga: 'AN RÉAMHFHOCAL'}, url: '/prepositions',},
    {title: {en: 'Pronouns', ga: 'AN FORAINM PEARSANTA'}, url: '/pronouns',},
    {title: {en: 'Interrogatives', ga: 'AN CHEIST'}, url: '/interrogatives',},
    {title: {en: 'Syntax', ga: 'AN CHÓMHRÉIR'}, url: '/syntax',},
    {title: {en: 'Conjunctions', ga: 'AN CÓNASC'}, url: '/conjunctions',},
    {title: {en: 'Mutations', ga: 'NA hATHRUITHE TOSAIGH'}, url: '/mutations',},
    {title: {en: 'Inflections', ga: 'INFHILLEADH NA FRÉIMHE'}, url: '/inflections',},
    {title: {en: 'Counting', ga: 'NA hUIMHREACHA'}, url: '/counting',},
];
---

<PageContent title="Home">
    <article class="w-full">
        <header class="mb-16">
            <h1 class="text-6xl font-black tracking-tight mb-4">
                Foghlaim <span class="text-brand-primary dark:text-brand-primary-dark">Gaeilge.</span>
            </h1>
            <p class="text-lg">
                A structured approach to Irish grammar, built for clarity and speed.
            </p>
        </header>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {modules.map(module => (
                    <a href={module.url}
                       class="group relative md:flex-row md:items-center justify-between p-8 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl hover:border-brand-primary transition-all duration-300 no-underline shadow-sm hover:shadow-xl hover:shadow-emerald-500/5">
                        <Card>
                            <span class="text-xs font-bold tracking-widest text-brand-primary dark:text-brand-primary-dark">
                                {module.title.ga}
                            </span>
                            <h2 class="mt-3 text-3xl font-bold group-hover:text-brand-primary transition-colors">
                                {module.title.en}
                            </h2>
                        </Card>
                    </a>
            ))}
        </div>
    </article>
</PageContent>