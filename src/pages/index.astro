---
import PageContent from "../layouts/PageContent.astro";
import Card from "../components/Card.astro";
import {getCollection} from 'astro:content';
import {directChildrenForPath, moduleMetadata, type TreeChild} from '../lib/contentTree';

type Module = {
    title: Record<'en' | 'ga', string>,
    url: string,
    pageCount: number,
    children: TreeChild[],
}

const entries = await getCollection('grammar');

const modules = directChildrenForPath(entries, '')
    .filter((child) => child.kind === 'folder')
    .map<Module>((child) => {
        const moduleSlug = child.slug;

        return {
            title: {
                en: child.title,
                ga: moduleMetadata[moduleSlug]?.ga ?? child.title.toUpperCase(),
            },
            url: child.href,
            pageCount: child.count ?? 0,
            children: directChildrenForPath(entries, moduleSlug),
        }
    });

const startUrl = modules[0]?.url ?? '#modules';
---

<PageContent title="Home">
    <article class="w-full max-w-6xl mx-auto">

        <header class="mb-20 mt-8 flex flex-col items-start">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-900/30 text-brand-primary dark:text-emerald-400 text-sm font-semibold tracking-wide mb-6">
                <span>Irish Grammar</span>
            </div>

            <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black tracking-tight mb-6 text-slate-900 dark:text-white">
                Gramadach na <span class="text-brand-primary dark:text-brand-primary-dark">Gaeilge.</span>
            </h1>

            <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400 mb-10 max-w-2xl leading-relaxed">
                A structured approach to Irish grammar, built for clarity and speed. Whether you're starting fresh or
                brushing up, jump right in.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
                <a href={startUrl}
                   class="inline-flex justify-center items-center px-8 py-4 bg-brand-primary hover:bg-brand-primary/90 text-white font-bold rounded-2xl transition-all shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/40 hover:-translate-y-0.5">
                    Start Learning
                </a>
                <a href="#modules"
                   class="inline-flex justify-center items-center px-8 py-4 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold rounded-2xl transition-all">
                    Browse Topics
                </a>
            </div>
        </header>

        <hr class="border-slate-200 dark:border-slate-800 mb-12"/>

        <section id="modules">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white">All Modules</h2>
                <span class="text-sm font-medium text-slate-500 dark:text-slate-400">{modules.length} Topics</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {modules.map(module => (
                        <a href={module.url}
                           class="group relative flex flex-col justify-center rounded-lg border border-slate-200 bg-white p-6 no-underline shadow-sm transition-all duration-300 hover:border-brand-primary hover:shadow-lg hover:shadow-emerald-500/5 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-primary sm:p-8">
                            <Card>
                                <span class="text-xs font-bold tracking-widest text-brand-primary dark:text-brand-primary-dark">
                                    {module.title.ga}
                                </span>
                                <h3 class="mt-3 text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white group-hover:text-brand-primary dark:group-hover:text-brand-primary-dark transition-colors">
                                    {module.title.en}
                                </h3>
                                <span class="mt-4 block text-sm font-medium text-slate-500 dark:text-slate-400">
                                    {module.pageCount} articles
                                </span>
                            </Card>
                        </a>
                ))}
            </div>
        </section>

    </article>
</PageContent>
