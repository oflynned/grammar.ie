---
import PageContent from "../layouts/PageContent.astro";
import Card from "../components/Card.astro";

type Module = {
    title: Record<'en' | 'ga', string>,
    url: string,
}

const modules: Module[] = [
    {title: {en: 'Nouns', ga: 'AN tAINMFHOCAL'}, url: '/nouns',},
    {title: {en: 'Articles', ga: 'AN CÓNASC'}, url: '/articles',},
    {title: {en: 'Adjectives', ga: 'AN AIDIACHT'}, url: '/adjectives',},
    {title: {en: 'Copula', ga: 'AN CHOPAIL'}, url: '/copula',},
    {title: {en: 'Verbs', ga: 'AN BRIATHAR'}, url: '/verbs',},
    {title: {en: 'Adverbs', ga: 'AN DOBRIATHAR'}, url: '/adverbs',},
    {title: {en: 'Prepositions', ga: 'AN RÉAMHFHOCAL'}, url: '/prepositions',},
    {title: {en: 'Pronouns', ga: 'AN FORAINM PEARSANTA'}, url: '/pronouns',},
    {title: {en: 'Interrogatives', ga: 'AN CHEIST'}, url: '/interrogatives',},
    {title: {en: 'Syntax', ga: 'AN CHÓMHRÉIR'}, url: '/syntax',},
    {title: {en: 'Conjunctions', ga: 'AN CÓNASC'}, url: '/conjunctions',},
    {title: {en: 'Mutations', ga: 'NA hATHRUITHE TOSAIGH'}, url: '/mutations',},
    {title: {en: 'Inflections', ga: 'INFHILLEADH NA FRÉIMHE'}, url: '/inflections',},
    {title: {en: 'Counting', ga: 'NA hUIMHREACHA'}, url: '/counting',},
];
---

<PageContent title="Home">
    <article class="w-full max-w-6xl mx-auto">

        <header class="mb-20 mt-8 flex flex-col items-start">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-900/30 text-brand-primary dark:text-emerald-400 text-sm font-semibold tracking-wide mb-6">
                <span>Grammar Guide</span>
            </div>

            <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black tracking-tight mb-6 text-slate-900 dark:text-white">
                Foghlaim <span class="text-brand-primary dark:text-brand-primary-dark">Gaeilge.</span>
            </h1>

            <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400 mb-10 max-w-2xl leading-relaxed">
                A structured approach to Irish grammar, built for clarity and speed. Whether you're starting fresh or brushing up, jump right in.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
                <a href="/nouns" class="inline-flex justify-center items-center px-8 py-4 bg-brand-primary hover:bg-brand-primary/90 text-white font-bold rounded-2xl transition-all shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/40 hover:-translate-y-0.5">
                    Start Learning
                </a>
                <a href="#modules" class="inline-flex justify-center items-center px-8 py-4 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold rounded-2xl transition-all">
                    Browse Topics
                </a>
            </div>
        </header>

        <hr class="border-slate-200 dark:border-slate-800 mb-12" />

        <section id="modules">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white">All Modules</h2>
                <span class="text-sm font-medium text-slate-500 dark:text-slate-400">{modules.length} Topics</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {modules.map(module => (
                        <a href={module.url}
                           class="group relative flex flex-col justify-center p-8 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl hover:border-brand-primary dark:hover:border-brand-primary transition-all duration-300 no-underline shadow-sm hover:shadow-xl hover:shadow-emerald-500/5">
                            <Card>
                                <span class="text-xs font-bold tracking-widest text-brand-primary dark:text-brand-primary-dark">
                                    {module.title.ga}
                                </span>
                                <h3 class="mt-3 text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white group-hover:text-brand-primary dark:group-hover:text-brand-primary-dark transition-colors">
                                    {module.title.en}
                                </h3>
                            </Card>
                        </a>
                ))}
            </div>
        </section>

    </article>
</PageContent>