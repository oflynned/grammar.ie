---
import Page from '../layouts/Page.astro';

const title = 'Not Found';
---

<Page
    title={title}
    seoTitle="Page Not Found | Grammar.ie"
    description="The requested Irish grammar page could not be found on Grammar.ie."
    noindex={true}
>
    <main class="flex flex-col items-center justify-center min-h-[70vh] px-4 text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-primary dark:text-brand-primary-dark mb-4">
            404 Earráid / 404 Error
        </span>
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white mb-4">
            Page Not Found
        </h1>
        <p class="text-lg text-slate-600 dark:text-slate-400 max-w-md mb-8">
            Ní bhfuarthas an leathanach seo. The Irish grammar topic or page you are looking for does not exist or has been moved.
        </p>
        <a
            href="/"
            class="inline-flex items-center justify-center px-6 py-3 bg-brand-primary hover:bg-brand-primary/90 text-white font-bold rounded-xl transition-all shadow-md shadow-emerald-500/20"
        >
            Back to Home
        </a>
    </main>
</Page>
