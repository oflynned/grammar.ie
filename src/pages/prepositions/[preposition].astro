---
import type {CollectionEntry} from 'astro:content';
import {getCollection} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Navigation from "../../components/Navigation.astro";
import Tag from "../../components/Tag.astro";

export async function getStaticPaths() {
    const prepositionEntries = await getCollection('prepositions');

    return prepositionEntries.map((entry: CollectionEntry<'prepositions'>) => {
        return {
            params: {preposition: entry.slug},
            props: {entry},
        }
    })
}

interface Props {
    entry: CollectionEntry<'prepositions'>;
}

const {entry} = Astro.props;
const {Content, headings} = await entry.render();
---

<Layout title={entry.data.title}>
    <main class="flex flex-col min-h-screen transition-colors duration-300">
        <Navigation category="Prepositions" url="/prepositions"/>

        <section class="flex mx-auto w-full max-w-6xl gap-12 px-4 py-12">
            <article class="flex-1 min-w-0 prose dark:prose-invert">
                <header class="mb-12 pb-8">
                    <h1 class="text-5xl font-bold mb-4 tracking-tight">
                        {entry.data.title}
                    </h1>

                    <p class="leading-relaxed text-lg">
                        {entry.data.description}
                    </p>

                    <div class="flex gap-2 mt-6">
                        {entry.data.tags.map(tag => (
                                <Tag tag={tag}/>
                        ))}
                    </div>
                </header>

                <Content/>
            </article>

            <aside class="hidden md:block w-64 flex-shrink-0">
                <div class="sticky top-32">
                    <TableOfContents headings={headings}/>
                </div>
            </aside>
        </section>
    </main>
</Layout>

<script>
    const headings = document.querySelectorAll('article h2, article h3');
    const LINK_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-link transition-all duration-300 absolute inset-0"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>';
    const COPIED_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide-check transition-all duration-300 absolute inset-0 opacity-0 scale-50"><path d="m12 15l2 2l4-4"></path><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>';

    headings.forEach((heading) => {
        const id = heading.getAttribute('id');
        if (!id) return;

        const anchor = document.createElement('a');
        anchor.href = `#${id}`;
        anchor.className = 'anchor-link relative ml-2 w-6 h-6 opacity-100 md:opacity-0 group-hover:opacity-100 transition-all duration-300 text-slate-500 dark:text-slate-400 flex items-center justify-center no-underline';
        anchor.innerHTML = `${LINK_SVG}${COPIED_SVG}`;
        anchor.title = 'Copy link to this section';

        anchor.addEventListener('click', (e) => {
            e.preventDefault();

            const url = new URL(window.location.href);
            url.hash = id;
            navigator.clipboard.writeText(url.toString());

            const linkIcon = anchor.querySelector('.lucide-link');
            const checkIcon = anchor.querySelector('.lucide-check');

            linkIcon?.classList.add('opacity-0', 'scale-50');
            checkIcon?.classList.remove('opacity-0', 'scale-50');
            checkIcon?.classList.add('opacity-100', 'scale-100');

            setTimeout(() => {
                linkIcon?.classList.remove('opacity-0', 'scale-50');
                checkIcon?.classList.add('opacity-0', 'scale-50');
                checkIcon?.classList.remove('opacity-100', 'scale-100');
            }, 1000);

            window.history.pushState(null, '', `#${id}`);
        });

        heading.classList.add('group', 'flex', 'items-center');
        heading.appendChild(anchor);
    });
</script>