---
import PageContent from "../../layouts/PageContent.astro";
import Card from '../../components/Card.astro'
import {type CollectionEntry, getCollection} from 'astro:content';

const pages = await getCollection('verbs');

// Group by the full nested folder path
const groups = pages.reduce<Record<string, CollectionEntry<'verbs'>[]>>((acc, page) => {
    const parts = page.slug.split('/');

    // If there is more than 1 part, join all parts except the last one (the file itself).
    // If there is no slash, assign it to 'root'.
    const folderPath = parts.length > 1 ? parts.slice(0, -1).join('/') : 'root';

    if (!acc[folderPath]) {
        acc[folderPath] = [];
    }

    acc[folderPath].push(page);

    return acc;
}, {});


const toSentenceCase = (name: string) => {
    return name
        .replace(/-/g, ' ')
        .replace(/\b\w/g, (l) => l.toUpperCase());
}

const folders = Object.keys(groups).toSorted();
---

<PageContent title="verbs">
    <section class="mx-auto w-full max-w-6xl flex-1 prose dark:prose-invert">
        <h1>Verbs</h1>

        {folders.map(folder => {
            return (
                    <section>
                        <h2>{toSentenceCase(folder)}</h2>
                        <ol class="not-prose grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 list-none p-0">
                            {groups[folder].toSorted((a, b) => a.data.title.localeCompare(b.data.title)).map(page => (
                                    <li class="group list-none">
                                        <a
                                                href={`/verbs/${page.slug}`}
                                                class="block p-6 h-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 hover:border-emerald-500 hover:shadow-xl hover:shadow-emerald-500/5 transition-all duration-300 rounded-2xl no-underline"
                                        >
                                            <Card>
                                                <span class="font-bold text-xl text-slate-800 dark:text-slate-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                                                    {page.data.title}
                                                </span>
                                            </Card>
                                        </a>
                                    </li>
                            ))}
                        </ol>
                    </section>
            )
        })}
    </section>
</PageContent>
